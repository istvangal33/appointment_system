# Node.js Backend Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/appointment_system?schema=public"

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this-in-production

# Django Backend Configuration (Keep for existing Django app)
DB_HOST=your_database_host
DB_PORT=your_database_port
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Stripe Configuration
STRIPE_API_KEY=your_stripe_api_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# Notification Services
NOTIFICATION_SERVICE_URL=your_notification_service_url
NOTIFICATION_SERVICE_API_KEY=your_notification_service_api_key
