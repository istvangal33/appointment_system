// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyRole {
  OWNER
  ADMIN
  STAFF
  MEMBER
}

enum CalendarType {
  PERSONAL
  RESOURCE
  SHARED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ExceptionType {
  HOLIDAY
  SICK_LEAVE
  VACATION
  CUSTOM
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships CompanyMembership[]
  calendars   Calendar[]
  
  @@map("users")
}

model Company {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  settings    Json?    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships     CompanyMembership[]
  calendars       Calendar[]
  services        Service[]
  appointments    Appointment[]
  exceptions      Exception[]
  workingHourTemplates WorkingHourTemplate[]

  @@map("companies")
}

model CompanyMembership {
  id        String      @id @default(uuid())
  userId    String
  companyId String
  role      CompanyRole
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, role])
  @@map("company_memberships")
}

model Calendar {
  id          String       @id @default(uuid())
  companyId   String
  ownerUserId String?
  name        String
  type        CalendarType
  color       String?
  settings    Json?        @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerUser    User?                  @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  appointments AppointmentResource[]
  workingHourTemplates WorkingHourTemplate[]

  @@index([companyId, ownerUserId])
  @@map("calendars")
}

model Service {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  duration    Int      // Duration in minutes
  price       Float?
  active      Boolean  @default(true)
  settings    Json?    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([companyId, active])
  @@map("services")
}

model Appointment {
  id              String            @id @default(uuid())
  companyId       String
  serviceId       String?
  customerName    String
  customerEmail   String
  customerPhone   String?
  start           DateTime
  end             DateTime
  status          AppointmentStatus @default(PENDING)
  notes           String?
  publicToken     String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company   Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service   Service?               @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  resources AppointmentResource[]

  @@index([companyId, start])
  @@map("appointments")
}

model AppointmentResource {
  id            String   @id @default(uuid())
  appointmentId String
  calendarId    String
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  calendar    Calendar    @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, calendarId])
  @@map("appointment_resources")
}

model WorkingHourTemplate {
  id         String   @id @default(uuid())
  companyId  String
  calendarId String?
  dayOfWeek  Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime  String   // Format: "HH:MM"
  endTime    String   // Format: "HH:MM"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  calendar Calendar? @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@map("working_hour_templates")
}

model Exception {
  id        String        @id @default(uuid())
  companyId String
  type      ExceptionType
  title     String
  startDate DateTime
  endDate   DateTime
  allDay    Boolean       @default(true)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("exceptions")
}
